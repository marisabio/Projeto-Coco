      propertyPath: 'names.Array.data[9]'
      value: "Dona Quit\xE9ria"
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: profiles.Array.size
      value: 17
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[10]'
      value: "O que \xE9 um Bilhete \xDAnico? "
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[11]'
      value: 'Simples, '
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[12]'
      value: "A rel\xEDquia mais poderosa dessa cidade. "
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[13]'
      value: "Se \xE9 perigoso?"
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[14]'
      value: "(Sil\xEAncio dram\xE1tico.) "
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[15]'
      value: "\xC9 S\xE3o Paulo, pintinho. "
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[16]'
      value: "Tudo \xE9 perigoso. "
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
