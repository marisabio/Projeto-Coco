      objectReference: {fileID: 1556216355}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[0]'
      value: "\xD4. Voc\xEA t\xE1 viva. "
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: "J\xE1 \xE9 um \xF3timo come\xE7o pra quem veio parar na Pra\xE7a da
        S\xE9. "
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: "N\xE3o precisa me olhar assim. "
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: "Eu tamb\xE9m n\xE3o sei como um pintinho veio parar aqui. "
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[4]'
      value: "Na verdade, at\xE9 sei\u2026 Vi o momento em que um desses caminh\xF5es
        de Fast Food deixaram voc\xEA e uma galinha ca\xEDrem por aqui. "
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[5]'
      value: "Imagino que voc\xEA queira encontrar aquela galinha\u2026 O que, o
        nome dela \xE9 Clarita? Saquei."
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[6]'
      value: "Seguinte, ela foi naquela dire\xE7\xE3o. \xC9 meio simples chegar l\xE1. "
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[7]'
      value: "Mas escuta bem: sem um Bilhete \xDAnico voc\xEA n\xE3o vai passar das
        catracas."
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[8]'
      value: 'Existe um guardado abaixo da Catedral. '
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'lines.Array.data[9]'
      value: "(Dona Quit\xE9ria abaixa o tom.)"
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'names.Array.data[0]'
      value: "Dona Quit\xE9ria"
      objectReference: {fileID: 0}
    - target: {fileID: 1851529181722156019, guid: fb524d7e3640c271a869db93639ca5a7, type: 3}
      propertyPath: 'names.Array.data[1]'
      value: "Dona Quit\xE9ria"
      objectReference: {fileID: 0}
